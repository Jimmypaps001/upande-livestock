  "name": "Livestock Navigation",
  "private": 0,
  "roles": [],
  "script": "(function () {\n  // Role-gate the tiles, the way the SCP Navigation block does: an empty\n  // data-roles shows for everyone, otherwise the user must hold one of the\n  // named roles. A System Manager or the Administrator sees everything.\n  //\n  // This HIDES a tile rather than disabling it. A greyed-out \"Culling\" tells a\n  // milker there is a thing they cannot have; an absent one tells them nothing,\n  // which is the truth as far as their job is concerned.\n  var root =\n    typeof root_element !== \"undefined\" && root_element\n      ? root_element\n      : document.querySelector(\".uln\");\n  if (!root) return;\n\n  var roles = (window.frappe && frappe.user_roles) || [];\n  var isAdmin =\n    roles.indexOf(\"System Manager\") >= 0 ||\n    roles.indexOf(\"Administrator\") >= 0 ||\n    (window.frappe && frappe.user && frappe.user.name === \"Administrator\");\n\n  root.querySelectorAll(\".uln-tile\").forEach(function (tile) {\n    var need = (tile.getAttribute(\"data-roles\") || \"\")\n      .split(\",\")\n      .map(function (s) { return s.trim(); })\n      .filter(Boolean);\n    if (!need.length) return;\n    var ok = isAdmin || need.some(function (r) { return roles.indexOf(r) >= 0; });\n    if (!ok) tile.classList.add(\"uln-hide\");\n  });\n})();\n",
  "style": ".uln{padding:4px 2px;font-family:'Poppins',var(--font-stack),'Inter',sans-serif;}\n.uln-title{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;font-weight:600;margin:0 0 10px 2px;}\n.uln-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;}\n.uln-tile{display:flex;align-items:center;gap:11px;padding:13px 15px;border:1px solid var(--border-color,#e2e4e9);border-radius:10px;background:var(--card-bg,#fff);text-decoration:none;color:inherit;transition:box-shadow .18s ease,transform .18s ease;}\n.uln-tile:hover{box-shadow:0 2px 6px rgba(0,0,0,.06);transform:translateY(-1px);text-decoration:none;}\n.uln-tile:hover .uln-lb,.uln-tile:hover .uln-sub{text-decoration:none;}\n.uln-ic{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;}\n.uln-ic svg{width:18px;height:18px;}\n.uln-tx{min-width:0;display:flex;flex-direction:column;}\n.uln-lb{display:block;font-size:13.5px;font-weight:600;line-height:1.2;}\n.uln-sub{display:block;font-size:11px;color:#8a8f98;line-height:1.3;margin-top:2px;}\n.uln-foot{margin:12px 2px 0;font-size:11px;color:#8a8f98;}\n.uln-hide{display:none !important;}\n"
 }
