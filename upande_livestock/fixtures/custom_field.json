[
 {
  "doctype": "Custom Field",
  "name": "Herds-custom_is_milking",
  "default": "0",
  "description": "Check if this herd contains milking cows (lactating groups)",
  "dt": "Herds",
  "fieldname": "custom_is_milking",
  "fieldtype": "Check",
  "insert_after": "herd_name",
  "label": "Is Milking Herd",
  "module": "Upande Livestock"
 },
 {
  "doctype": "Custom Field",
  "name": "Herds-custom_is_calf_rearing",
  "default": "0",
  "description": "Tick if this herd contains calves on milk feeding (e.g. 0-2 months). Calf Feeding events validate that the calf's current herd has this flag set.",
  "dt": "Herds",
  "fieldname": "custom_is_calf_rearing",
  "fieldtype": "Check",
  "in_standard_filter": 1,
  "insert_after": "custom_is_milking",
  "label": "Is Calf-Rearing Herd",
  "module": "Upande Livestock"
 },
 {
  "doctype": "Custom Field",
  "name": "Herds-custom_production_group",
  "depends_on": "eval:doc.custom_is_milking",
  "description": "Maps this herd to a production group for KPI tracking (matches Excel tracker Group 1/2/3)",
  "dt": "Herds",
  "fieldname": "custom_production_group",
  "fieldtype": "Select",
  "insert_after": "custom_is_milking",
  "label": "Production Group",
  "module": "Upande Livestock",
  "options": "\nGroup 1\nGroup 2\nGroup 3"
 },
 {
  "doctype": "Custom Field",
  "name": "Herds-custom_is_dry",
  "default": "0",
  "description": "Tick if this herd contains dry cows or steaming-up cows. Excluded from milk recording.",
  "dt": "Herds",
  "fieldname": "custom_is_dry",
  "fieldtype": "Check",
  "in_standard_filter": 1,
  "insert_after": "custom_is_calf_rearing",
  "label": "Is Dry / Pre-calving Herd",
  "module": "Upande Livestock"
 },
 {
  "doctype": "Custom Field",
  "name": "Herds-custom_herd_category",
  "description": "Herd category for KPI grouping: Milking, Dry, Youngstock",
  "dt": "Herds",
  "fieldname": "custom_herd_category",
  "fieldtype": "Select",
  "insert_after": "custom_production_group",
  "label": "Herd Category",
  "module": "Upande Livestock",
  "options": "\nMilking\nDry\nYoungstock > 12m\nYoungstock < 12m"
 },
 {
  "doctype": "Custom Field",
  "name": "Herds-custom_feed_account",
  "description": "Expense account for feed costs for this herd. Overrides the global setting in Livestock Settings.",
  "dt": "Herds",
  "fieldname": "custom_feed_account",
  "fieldtype": "Link",
  "insert_after": "cost_center",
  "label": "Feed Expense Account (override)",
  "module": "Upande Livestock",
  "options": "Account"
 },
 {
  "doctype": "Custom Field",
  "name": "Herds-custom_vet_account",
  "description": "Expense account for vet/drug costs for this herd. Overrides the global setting.",
  "dt": "Herds",
  "fieldname": "custom_vet_account",
  "fieldtype": "Link",
  "insert_after": "custom_feed_account",
  "label": "Vet / Drug Expense Account (override)",
  "module": "Upande Livestock",
  "options": "Account"
 },
 {
  "doctype": "Custom Field",
  "name": "Herds-custom_cost_center",
  "description": "Cost centre for this herd. All JEs for events, feed, vet costs, and milk for this herd use this cost centre. Pulled from Livestock Settings if not set.",
  "dt": "Herds",
  "fieldname": "custom_cost_center",
  "fieldtype": "Link",
  "insert_after": "bom",
  "label": "Cost Center",
  "module": "Upande Livestock",
  "options": "Cost Center"
 },
 {
  "doctype": "Custom Field",
  "name": "Animal Event-custom_calving_outcome",
  "dt": "Animal Event",
  "fieldname": "custom_calving_outcome",
  "fieldtype": "Select",
  "label": "Calving outcome",
  "insert_after": "event_type",
  "options": "Live Birth\nStill Birth\nAbortion",
  "translatable": 1,
  "module": "Upande Livestock"
 },
 {
  "doctype": "Custom Field",
  "name": "Animal Event-custom_no_of_calves",
  "dt": "Animal Event",
  "fieldname": "custom_no_of_calves",
  "fieldtype": "Int",
  "label": "No Of Calves",
  "insert_after": "custom_calving_outcome",
  "module": "Upande Livestock"
 },
 {
  "doctype": "Custom Field",
  "name": "Animal Event-custom_calf_sex",
  "dt": "Animal Event",
  "fieldname": "custom_calf_sex",
  "fieldtype": "Select",
  "label": "Calf Sex",
  "insert_after": "custom_no_of_calves",
  "options": "Male\nFemale",
  "translatable": 1,
  "module": "Upande Livestock"
 },
 {
  "doctype": "Custom Field",
  "name": "Animal Event-custom_related_pregnancy",
  "dt": "Animal Event",
  "fieldname": "custom_related_pregnancy",
  "fieldtype": "Link",
  "label": "Related Pregnancy",
  "insert_after": "custom_calf_sex",
  "options": "Animal Event",
  "module": "Upande Livestock"
 },
 {
  "doctype": "Custom Field",
  "name": "Animal Event-custom_status_after_test",
  "dt": "Animal Event",
  "fieldname": "custom_status_after_test",
  "fieldtype": "Select",
  "label": "Status after test",
  "insert_after": "service_status",
  "options": "Pending\nSuccessfull\nFailed",
  "default": "Pending",
  "allow_on_submit": 1,
  "translatable": 1,
  "module": "Upande Livestock"
 },
 {
  "doctype": "Custom Field",
  "name": "Asset-custom_is_livestock",
  "dt": "Asset",
  "fieldname": "custom_is_livestock",
  "fieldtype": "Check",
  "label": "Is Livestock?",
  "insert_after": "asset_name",
  "module": "Upande Livestock"
 },
 {
  "doctype": "Custom Field",
  "name": "Asset-custom_current_herd",
  "dt": "Asset",
  "fieldname": "custom_current_herd",
  "fieldtype": "Link",
  "label": "Current herd",
  "placeholder": "Enter the Cow's herd",
  "insert_after": "custom_is_livestock",
  "options": "Herds",
  "ignore_user_permissions": 1,
  "allow_on_submit": 1,
  "module": "Upande Livestock"
 }
]
